        let name = self.name();
        let mut alias = name.to_string();

        for (from, to) in [
            ("System.Int32", "int"),
            ("System.UInt32", "uint"),
            ("System.Int16", "short"),
            ("System.UInt16", "ushort"),
            ("System.Int64", "long"),
            ("System.UInt64", "ulong"),
