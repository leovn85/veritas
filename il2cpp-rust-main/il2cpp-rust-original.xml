    pub fn items(&self) -> Il2CppArray {
        unsafe { Il2CppArray(*((self.0.byte_offset(16)) as *const *const c_void)) }
    }
    pub fn size(&self) -> i32 {
        unsafe { *((self.0.byte_offset(24)) as *const i32) }
